[Unit]
Description=Static network setup for the qvm guest links
# udev is what applies the .link files that rename the two virtio-net devices,
# so this cannot run before it. The script waits for the renamed interfaces
# itself rather than ordering after systemd-udev-settle.service, which is
# deprecated and not guaranteed to be pulled into the transaction.
After=systemd-udevd.service
Before=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/network-setup.sh

[Install]
WantedBy=multi-user.target
