bootloader --ptable msdos
part /boot --ondisk mmcblk0 --source bootimg-partition --fstype=vfat --label boot --active --align 4 --size 128
part /     --ondisk mmcblk0 --source rootfs --fstype=ext4 --label rootfs_a --align 4 --size 2000
part /     --ondisk mmcblk0 --source rootfs --fstype=ext4 --label rootfs_b --align 4 --size 2000