[Unit]
Description=Motor AI SOME/IP service (guest-2)
Documentation=https://github.com/PM-Maestro-ITI-GP-Org/motor_ai_server
# vsomeip binds the "unicast" address from its config at startup and exits if it
# does not exist yet. That address (10.0.2.2, the guest_to_guest link to the QNX
# guest) is brought up by network-setup, so ordering after it is not cosmetic --
# without it the service loses a boot race roughly every time.
After=network-setup.service
Requires=network-setup.service
# Only ordering. The service does not need the node to come up, and does not
# fail without it: a window with no live pid in ai_pid_file is logged and the
# previous verdict is kept. Wants= rather than Requires= says exactly that.
Wants=motor-ai-node.service
After=motor-ai-node.service

[Service]
Type=simple
Environment=VSOMEIP_CONFIGURATION=/etc/motor-ai-server/vsomeip.json
Environment=COMMONAPI_CONFIG=/etc/motor-ai-server/commonapi.ini
Environment=MOTOR_AI_SERVER_CONFIG=/etc/motor-ai-server/server.conf
# StateDirectory is gone with the switch from exec-per-window to the signalled
# node. The two programs now share /motor_data -- data_dir in both configs --
# which is an absolute path outside /var and so not something StateDirectory
# can manage. Both create it themselves at startup, and both run as root, so
# whichever comes up first finds or makes it.
ExecStart=/usr/bin/motor_ai_server
# The service retries registerService() in a loop rather than exiting, so a
# restart here is for genuine crashes only.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
